# Worsyn Backend — variables de entorno
# Copia este archivo como .env y ajusta los valores

APP_NAME=Worsyn API
APP_VERSION=0.1.0
DEBUG=false
SECRET_KEY=change-me-in-production-use-a-long-random-string-min-32-chars

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://worsyn:worsyn@db:5432/worsyn

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — add your frontend URL
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3001"]
